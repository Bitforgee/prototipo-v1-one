@startuml modelo_logico
!pragma layout smetana
skinparam dpi 200
left to right direction
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
hide circle

entity usuario {
  * id : bigint <<PK>>
  --
  * nome : varchar(150)
  * email : varchar(254) <<UK>>
  * ativo : boolean
}
entity usuario_papel {
  * usuario_id : bigint <<PK, FK>>
  * papel : varchar(20) <<PK>>
}
entity curso {
  * id : bigint <<PK>>
  --
  * nome : varchar(150)
  coordenacao_setor_id : bigint <<FK>>
}
entity aluno_curso {
  * usuario_id : bigint <<PK, FK>>
  * curso_id : bigint <<PK, FK>>
  --
  * semestre : smallint
}
entity setor {
  * id : bigint <<PK>>
  --
  * nome : varchar(100)
  * triagem : boolean
}
entity atendente_setor {
  * usuario_id : bigint <<PK, FK>>
  * setor_id : bigint <<PK, FK>>
}
entity categoria {
  * id : bigint <<PK>>
  --
  * nome : varchar(100) <<UK>>
}
entity regra_roteamento {
  * id : bigint <<PK>>
  --
  * categoria_id : bigint <<FK, UK>>
  * destino : varchar(30)
  setor_id : bigint <<FK>>
}
entity artigo {
  * id : bigint <<PK>>
  --
  * categoria_id : bigint <<FK>>
  * status : varchar(20)
}
entity versao_artigo {
  * id : bigint <<PK>>
  --
  * artigo_id : bigint <<FK>>
  * numero : int
  * titulo : varchar(200)
  * perguntas : text
  * resposta : text
  links : text
  * atualizado_em : timestamptz
  * atualizado_por_id : bigint <<FK>>
}
entity conversa {
  * id : bigint <<PK>>
  --
  * aluno_id : bigint <<FK>>
  * iniciada_em : timestamptz
  desfecho : varchar(30)
  encerrada_em : timestamptz
}
entity mensagem_conversa {
  * id : bigint <<PK>>
  --
  * conversa_id : bigint <<FK>>
  * autor : varchar(20)
  * texto : text
  versao_artigo_id : bigint <<FK>>
  * enviada_em : timestamptz
}
entity chamado {
  * id : bigint <<PK>>
  --
  * numero : varchar(20) <<UK>>
  * conversa_id : bigint <<FK, UK>>
  * solicitante_id : bigint <<FK>>
  responsavel_id : bigint <<FK>>
  * curso_id : bigint <<FK>>
  * setor_id : bigint <<FK>>
  * categoria_id : bigint <<FK>>
  * categoria_original_id : bigint <<FK>>
  * titulo : varchar(200)
  descricao : text
  * estado : varchar(20)
  motivo_fechamento : varchar(30)
  * encaminhamentos : int
  * reaberturas : int
  * criado_em : timestamptz
}
entity mensagem_chamado {
  * id : bigint <<PK>>
  --
  * chamado_id : bigint <<FK>>
  * autor_id : bigint <<FK>>
  * tipo : varchar(20)
  * texto : text
  * aguarda_aluno : boolean
  * enviada_em : timestamptz
}
entity anexo {
  * id : bigint <<PK>>
  --
  * mensagem_chamado_id : bigint <<FK>>
  * nome_arquivo : varchar(255)
  * tipo_conteudo : varchar(100)
  * tamanho_bytes : int
}
entity evento_chamado {
  * id : bigint <<PK>>
  --
  * chamado_id : bigint <<FK>>
  * ator_id : bigint <<FK>>
  * tipo : varchar(30)
  detalhe : text
  * ocorrido_em : timestamptz
}

usuario ||--o{ usuario_papel
usuario ||--o{ aluno_curso
curso ||--o{ aluno_curso
usuario ||--o{ atendente_setor
setor ||--o{ atendente_setor
setor |o--o{ curso
categoria ||--o| regra_roteamento
setor |o--o{ regra_roteamento
categoria ||--o{ artigo
artigo ||--|{ versao_artigo
usuario ||--o{ versao_artigo
usuario ||--o{ conversa
conversa ||--|{ mensagem_conversa
versao_artigo |o--o{ mensagem_conversa
conversa ||--o| chamado
usuario ||--o{ chamado
curso ||--o{ chamado
setor ||--o{ chamado
categoria ||--o{ chamado
chamado ||--o{ mensagem_chamado
usuario ||--o{ mensagem_chamado
mensagem_chamado ||--o{ anexo
chamado ||--o{ evento_chamado
usuario ||--o{ evento_chamado
@enduml
