@startuml classes
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam monochrome true
skinparam classAttributeIconSize 0
hide empty methods

class Usuario {
  - nome: string
  - email: string
  - ativo: bool
  - papeis: Papel [1..*]
}
class Curso {
  - nome: string
}
class VinculoCurso {
  - semestre: int
}
class Setor {
  - nome: string
  - triagem: bool
}
class Categoria {
  - nome: string
}
class RegraRoteamento {
  - destino: TipoDestino
}
class Artigo {
  - status: StatusArtigo
}
class VersaoArtigo {
  - numero: int
  - titulo: string
  - perguntasRelacionadas: string [1..*]
  - resposta: string
  - links: string [0..*]
  - atualizadoEm: DateTime
}
class Conversa {
  - iniciadaEm: DateTime
  - desfecho: DesfechoConversa [0..1]
  - encerradaEm: DateTime [0..1]
}
class MensagemConversa {
  - autor: string
  - texto: string
  - enviadaEm: DateTime
}
class Chamado {
  - numero: string
  - titulo: string
  - descricao: string [0..1]
  - estado: EstadoChamado
  - motivoFechamento: MotivoFechamento [0..1]
  - encaminhamentos: int
  - reaberturas: int
  - criadoEm: DateTime
}
class MensagemChamado {
  - tipo: TipoMensagem
  - texto: string
  - aguardaAluno: bool
  - enviadaEm: DateTime
}
class Anexo {
  - nomeArquivo: string
  - tipoConteudo: string
  - tamanhoBytes: int
}
class EventoChamado {
  - tipo: string
  - detalhe: string
  - ocorridoEm: DateTime
}

Usuario "1" -- "0..*" VinculoCurso : aluno
VinculoCurso "0..*" -- "1" Curso
Usuario "0..*" -- "0..*" Setor : atende
Curso "0..*" --> "0..1" Setor : coordenação
RegraRoteamento "0..1" --> "1" Categoria
RegraRoteamento "0..*" --> "0..1" Setor : setor fixo
Artigo "0..*" --> "1" Categoria
Artigo "1" *-- "1..*" VersaoArtigo
VersaoArtigo "0..*" --> "1" Usuario : atualizadoPor
Usuario "1" -- "0..*" Conversa : aluno
Conversa "1" *-- "1..*" MensagemConversa
MensagemConversa "0..*" --> "0..1" VersaoArtigo : resposta exibida
Conversa "1" -- "0..1" Chamado
Chamado "0..*" --> "1" Usuario : solicitante
Chamado "0..*" --> "0..1" Usuario : responsável
Chamado "0..*" --> "1" Curso
Chamado "0..*" --> "1" Setor : setor atual
Chamado "0..*" --> "1" Categoria : categoria atual
Chamado "0..*" --> "1" Categoria : categoria original
Chamado "1" *-- "0..*" MensagemChamado
MensagemChamado "0..*" --> "1" Usuario : autor
MensagemChamado "1" *-- "0..*" Anexo
Chamado "1" *-- "0..*" EventoChamado
EventoChamado "0..*" --> "1" Usuario : ator
@enduml
