@startchen modelo_conceitual
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Times New Roman"

entity USUARIO {
  Id <<key>>
  Nome
  Email
  Ativo
  Papel <<multi>>
}
entity CURSO {
  Id <<key>>
  Nome
}
entity SETOR {
  Id <<key>>
  Nome
  Triagem
}
entity CATEGORIA {
  Id <<key>>
  Nome
}
entity REGRA_ROTEAMENTO {
  Id <<key>>
  Destino
}
entity ARTIGO {
  Id <<key>>
  Status
}
entity VERSAO_ARTIGO {
  Numero <<key>>
  Titulo
  Perguntas <<multi>>
  Resposta
  AtualizadoEm
}
entity CONVERSA {
  Id <<key>>
  IniciadaEm
  Desfecho
}
entity MENSAGEM_CONVERSA {
  Id <<key>>
  Autor
  Texto
}
entity CHAMADO {
  Numero <<key>>
  Titulo
  Estado
  Encaminhamentos
  Reaberturas
}
entity MENSAGEM_CHAMADO {
  Id <<key>>
  Tipo
  Texto
}
entity ANEXO {
  Id <<key>>
  NomeArquivo
  Tamanho
}
entity EVENTO_CHAMADO {
  Id <<key>>
  Tipo
  OcorridoEm
}

relationship CURSA {
  Semestre
}
relationship ATUA_EM {
}
relationship COORDENA {
}
relationship ROTEIA {
}
relationship DIRECIONA {
}
relationship CLASSIFICA {
}
relationship VERSIONA {
}
relationship INICIA {
}
relationship CONTEM {
}
relationship EXIBE {
}
relationship GERA {
}
relationship SOLICITA {
}
relationship ATRIBUIDO {
}
relationship ESTA_EM {
}
relationship ENQUADRA {
}
relationship REGISTRA {
}
relationship ANEXA {
}
relationship HISTORIA {
}

USUARIO -N- CURSA
CURSA -N- CURSO
USUARIO -N- ATUA_EM
ATUA_EM -N- SETOR
SETOR -1- COORDENA
COORDENA -N- CURSO
CATEGORIA -1- ROTEIA
ROTEIA -1- REGRA_ROTEAMENTO
REGRA_ROTEAMENTO -N- DIRECIONA
DIRECIONA -1- SETOR
CATEGORIA -1- CLASSIFICA
CLASSIFICA -N- ARTIGO
ARTIGO -1- VERSIONA
VERSIONA =N= VERSAO_ARTIGO
USUARIO -1- INICIA
INICIA -N- CONVERSA
CONVERSA -1- CONTEM
CONTEM =N= MENSAGEM_CONVERSA
MENSAGEM_CONVERSA -N- EXIBE
EXIBE -1- VERSAO_ARTIGO
CONVERSA -1- GERA
GERA -1- CHAMADO
USUARIO -1- SOLICITA
SOLICITA -N- CHAMADO
USUARIO -1- ATRIBUIDO
ATRIBUIDO -N- CHAMADO
SETOR -1- ESTA_EM
ESTA_EM -N- CHAMADO
CATEGORIA -1- ENQUADRA
ENQUADRA -N- CHAMADO
CHAMADO -1- REGISTRA
REGISTRA -N- MENSAGEM_CHAMADO
MENSAGEM_CHAMADO -1- ANEXA
ANEXA -N- ANEXO
CHAMADO -1- HISTORIA
HISTORIA -N- EVENTO_CHAMADO
@endchen
