---
config:
  layout: elk
  theme: neutral
  themeVariables:
    fontFamily: Times New Roman
    fontSize: 16px
---
classDiagram
  direction TB
  class Usuario {
    -nome: string
    -email: string
    -ativo: bool
    -papeis: Papel [1..*]
  }
  class Curso {
    -nome: string
  }
  class VinculoCurso {
    -semestre: int
  }
  class Setor {
    -nome: string
    -triagem: bool
  }
  class Categoria {
    -nome: string
  }
  class RegraRoteamento {
    -destino: TipoDestino
  }
  class Artigo {
    -status: StatusArtigo
  }
  class VersaoArtigo {
    -numero: int
    -titulo: string
    -perguntasRelacionadas: string [1..*]
    -resposta: string
    -links: string [0..*]
    -atualizadoEm: DateTime
  }
  class Conversa {
    -iniciadaEm: DateTime
    -desfecho: DesfechoConversa [0..1]
    -encerradaEm: DateTime [0..1]
  }
  class MensagemConversa {
    -autor: string
    -texto: string
    -enviadaEm: DateTime
  }
  class Chamado {
    -numero: string
    -titulo: string
    -descricao: string [0..1]
    -semestre: int
    -estado: EstadoChamado
    -motivoFechamento: MotivoFechamento [0..1]
    -encaminhamentos: int
    -reaberturas: int
    -criadoEm: DateTime
  }
  class MensagemChamado {
    -tipo: TipoMensagem
    -texto: string
    -aguardaAluno: bool
    -enviadaEm: DateTime
  }
  class Anexo {
    -nomeArquivo: string
    -tipoConteudo: string
    -tamanhoBytes: int
  }
  class EventoChamado {
    -tipo: string
    -detalhe: string
    -ocorridoEm: DateTime
  }

  Setor "0..*" -- "0..*" Usuario : atende
  Setor "0..1" <-- "0..*" Curso : coordenação
  Usuario "1" -- "0..*" VinculoCurso : aluno
  Curso "1" -- "0..*" VinculoCurso
  Categoria "1" <-- "0..1" RegraRoteamento
  Setor "0..1" <-- "0..*" RegraRoteamento : setor fixo
  Categoria "1" <-- "0..*" Artigo
  Artigo "1" *-- "1..*" VersaoArtigo
  Usuario "1" <-- "0..*" VersaoArtigo : atualizadoPor
  Usuario "1" -- "0..*" Conversa : aluno
  Conversa "1" *-- "1..*" MensagemConversa
  VersaoArtigo "0..1" <-- "0..*" MensagemConversa : resposta exibida
  Conversa "1" -- "0..1" Chamado
  Usuario "1" <-- "0..*" Chamado : solicitante
  Usuario "0..1" <-- "0..*" Chamado : responsável
  Curso "1" <-- "0..*" Chamado
  Setor "1" <-- "0..*" Chamado : setor atual
  Categoria "1" <-- "0..*" Chamado : categoria atual
  Categoria "1" <-- "0..*" Chamado : categoria original
  Chamado "1" *-- "0..*" MensagemChamado
  Usuario "1" <-- "0..*" MensagemChamado : autor
  MensagemChamado "1" *-- "0..*" Anexo
  Chamado "1" *-- "0..*" EventoChamado
  Usuario "1" <-- "0..*" EventoChamado : ator
